# Public domain, without https:// or a trailing slash.
DOMAIN=snabju.shop

# PostgreSQL: use a long, unique password in the server's .env file.
DB_NAME=snabju
DB_USER=snabju
DB_PASSWORD=replace_with_a_long_random_password

SERVER_PORT=8080
SESSION_TTL_HOURS=720

# Transactional email via UniSender Go.
UNISENDER_API_KEY=replace_with_unisender_api_key
UNISENDER_FROM_NAME=Snabju
SMTP_FROM=info@snabju.shop
ADMIN_EMAIL=snabjumanage@yandex.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=snabjumanage@yandex.ru

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional Ozon integration.
OZON_KEY=

# Tochka internet acquiring with the "Cheques" service. Never commit the production JWT.
TOCHKA_JWT=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# One of: osn, usn_income, usn_income_outcome, esn, patent.
TOCHKA_TAX_SYSTEM_CODE=
# One of: none, vat0, vat5, vat7, vat10, vat22, vat105, vat107, vat110, vat122.
TOCHKA_VAT_TYPE=
TOCHKA_PAYMENT_TTL_MINUTES=1440
