# Public domain, without https:// or a trailing slash.
DOMAIN=snabju.shop

# PostgreSQL: use a long, unique password in the server's .env file.
DB_NAME=snabju
DB_USER=snabju
DB_PASSWORD=replace_with_a_long_random_password

SERVER_PORT=8080
SESSION_TTL_HOURS=720

# Transactional email via UniSender Go.
UNISENDER_API_KEY=replace_with_unisender_api_key
UNISENDER_FROM_NAME=Snabju
SMTP_FROM=info@snabju.shop

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional Ozon integration.
OZON_KEY=
